# --- Neon Postgres -------------------------------------------------------
# Console -> your project -> Connection Details. Use the POOLED string (host
# contains "-pooler"): route handlers are short-lived, and the pooler is what
# stops them exhausting connections.
DATABASE_URL=

# --- Neon Auth -----------------------------------------------------------
# Console -> your project -> Auth -> Configuration. Enable Auth first.
NEON_AUTH_BASE_URL=

# Signs the session cookie. Must be 32+ characters. Generate one with:
#   openssl rand -base64 32
NEON_AUTH_COOKIE_SECRET=

# --- Email reminders (optional) -------------------------------------------
# Leave these blank and reminders stay in-app only: the cron endpoint reports
# itself unconfigured rather than failing, and nothing else changes.

# Resend Dashboard -> API Keys.
RESEND_API_KEY=

# A verified sender on a domain you own, e.g.
#   Workbench <no-reply@yourdomain.com>
REMINDER_FROM_EMAIL=

# Guards /api/cron/reminders. 16+ characters. Generate one with:
#   openssl rand -base64 24
# On Vercel, add it in project settings and it is sent for you as an
# Authorization: Bearer header. While it is unset the endpoint stays closed.
CRON_SECRET=

# Absolute base URL, used for the "open the board" link in the email.
APP_URL=
