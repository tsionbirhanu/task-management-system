# --- Neon Postgres -------------------------------------------------------
# Console -> your project -> Connection Details. Use the POOLED string (host
# contains "-pooler"): route handlers are short-lived, and the pooler is what
# stops them exhausting connections.
DATABASE_URL=

# --- Neon Auth -----------------------------------------------------------
# Console -> your project -> Auth -> Configuration. Enable Auth first.
NEON_AUTH_BASE_URL=

# Signs the session cookie. Must be 32+ characters. Generate one with:
#   openssl rand -base64 32
NEON_AUTH_COOKIE_SECRET=
